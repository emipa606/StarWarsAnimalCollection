  <!-- EN: That was some delicious meat, it can only have been Rycrit! -->
  <AteRycritMeat.stages.ate_rycrit_meat.description>这肉真好吃，只能是 Rycrit！</AteRycritMeat.stages.ate_rycrit_meat.description>
  <!-- EN: drank blue milk -->
  <DrankBlueMilk.stages.drank_blue_milk.label>喝蓝色牛奶</DrankBlueMilk.stages.drank_blue_milk.label>
