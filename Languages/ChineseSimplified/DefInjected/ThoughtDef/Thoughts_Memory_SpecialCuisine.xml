  <!-- EN: ate jogan fruit -->
  <AteJoganFruit.stages.ate_jogan_fruit.label>吃乔根果</AteJoganFruit.stages.ate_jogan_fruit.label>
  <!-- EN: Sweet with a crisp texture, it has to be jogan fruit. -->
  <AteJoganFruit.stages.ate_jogan_fruit.description>味道甜美，口感清脆，这一定是乔根果。</AteJoganFruit.stages.ate_jogan_fruit.description>
  <!-- EN: ate manax fungus -->
  <AteManaxFungus.stages.ate_manax_fungus.label>食人木耳</AteManaxFungus.stages.ate_manax_fungus.label>
