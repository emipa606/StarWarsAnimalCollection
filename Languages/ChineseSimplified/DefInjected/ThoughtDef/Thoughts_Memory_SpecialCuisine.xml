  <!-- EN: ate chak-root -->
  <AteChakroot.stages.ate_chakroot.label>吃 chak-root</AteChakroot.stages.ate_chakroot.label>
  <!-- EN: What a flavour, there's no mistaking the tangy sweetness of chak-root. -->
  <AteChakroot.stages.ate_chakroot.description>味道真不错，恰克根的香甜绝对不会错。</AteChakroot.stages.ate_chakroot.description>
  <!-- EN: ate rancor heart -->
  <AteChrysalideHeart.stages.ate_rancor_heart.label>吃掉了 rancor 的心脏</AteChrysalideHeart.stages.ate_rancor_heart.label>
