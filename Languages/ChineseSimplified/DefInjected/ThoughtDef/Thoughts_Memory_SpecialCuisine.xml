  <!-- EN: ate acklay claw -->
  <AteAcklayClaw.stages.ate_acklay_claw.label>吃掉爪子</AteAcklayClaw.stages.ate_acklay_claw.label>
  <!-- EN: These claws are so tender and sweet, the buttery flavour lingers on the tongue. -->
