  <!-- EN: drank green milk -->
  <DrankGreenMilk.stages.drank_green_milk.label>喝绿色牛奶</DrankGreenMilk.stages.drank_green_milk.label>
  <!-- EN: Sithspit! What karking thing made this?! It tastes like it's gone bad INSIDE the animal! -->
