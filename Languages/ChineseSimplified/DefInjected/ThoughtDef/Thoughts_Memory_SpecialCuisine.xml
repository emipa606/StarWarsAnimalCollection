  <!-- EN: ate bloddle -->
  <AteBloddle.stages.ate_bloddle.label>吃了布洛德尔</AteBloddle.stages.ate_bloddle.label>
  <!-- EN: Ah, you can't beat the aroma of cooked bloddle. -->
