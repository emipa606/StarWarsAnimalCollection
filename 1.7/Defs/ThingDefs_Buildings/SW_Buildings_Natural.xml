    <defName>sw_Sarlacc</defName>
    <nameMaker>SWNamerLandmark_Sarlacc</nameMaker>
    <label>sarlacc pit</label>
    <iconTexturePath>World/Landmarks/Landmark_Sarlacc</iconTexturePath>
    <atlasSize>(2, 2)</atlasSize>
    <commonality>0.1</commonality>
    <nameMaker>SWNamerLandmark_Sarlacc</nameMaker>
    <mutatorChances>
      <sw_SarlaccLair Required="True" />
      <Pollution_Increased MayRequire="Ludeon.RimWorld.Biotech">0.02</Pollution_Increased>
      <Junkyard MayRequire="Ludeon.RimWorld.Ideology">0.05</Junkyard>
      <ArcheanTrees>0.01</ArcheanTrees>
      <MineralRich>0.03</MineralRich>
      <MixedBiome>0.5</MixedBiome>
      <AncientUplink>0.02</AncientUplink>
      <Stockpile>0.05</Stockpile>
      <AnimalLife_Decreased>0.15</AnimalLife_Decreased>
      <Sandy>0.05</Sandy>
      <DryGround>0.05</DryGround>
      <MineralRich>0.05</MineralRich>
      <InsectMegahive>0.02</InsectMegahive>
      <FoggyMutator>0.05</FoggyMutator>
      <WildGalacticPlants>0.05</WildGalacticPlants>
      <WildRylothPlants>0.05</WildRylothPlants>
      <WildTattooinePlants>0.05</WildTattooinePlants>
      <WildNabooPlants>0.05</WildNabooPlants>
      <WildDantooinePlants>0.05</WildDantooinePlants>
      <WildAlderaanPlants>0.03</WildAlderaanPlants>
      <WildFelucianPlants>0.03</WildFelucianPlants>
    </mutatorChances>
    <comboLandmarkMutators>
      <Dunes>0.05</Dunes>
      <Sandy>0.02</Sandy>
      <Hollow>0.02</Hollow>
      <Chasm>0.02</Chasm>
      <Valley>0.01</Valley>
      <Cavern>0.01</Cavern>
    </comboLandmarkMutators>
  </LandmarkDef>
  <TileMutatorDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>sw_SarlaccLair</defName>
    <label>sarlacc pit</label>
    <description>This area hosts a juvenile sarlacc creature. These sessile creatures are known to have millenia long lifespans, the circular maws on the surface are supported by a massive undergorund body.</description>
    <biomeBlacklist>
      <li>SeaIce</li>
      <li>IceSheet</li>
      <li>GlacialPlain</li>
    </biomeBlacklist>
    <maxHilliness>Mountainous</maxHilliness>
    <extraGenSteps>
      <li>sw_SarlaccPit</li>
    </extraGenSteps>
  </TileMutatorDef>
  <GenStepDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>sw_SarlaccPit</defName>
    <order>950</order>
    <genStep Class="GenStep_ScatterThings">
      <thingDef>SarlaccPit</thingDef>
      <createUsedRect>true</createUsedRect>
      <allowInWaterBiome>false</allowInWaterBiome>
      <skipRoofed>true</skipRoofed>
      <countPer10kCellsRange>1~1</countPer10kCellsRange>
      <clearSpaceSize>10</clearSpaceSize>
      <terrainValidationDisallowed>
        <li>Road</li>
      </terrainValidationDisallowed>
      <count>1</count>
      <warnOnFail>false</warnOnFail>
    </genStep>
  </GenStepDef>
  <LandmarkDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>sw_DeadSarlacc</defName>
    <label>dead Sarlacc</label>
    <iconTexturePath>World/Landmarks/Landmark_DeadSarlacc</iconTexturePath>
    <atlasSize>(2, 2)</atlasSize>
    <commonality>0.1</commonality>
    <mutatorChances>
      <sw_DeadSarlaccCave Required="True" />
      <Pollution_Increased MayRequire="Ludeon.RimWorld.Biotech">0.02</Pollution_Increased>
      <Junkyard MayRequire="Ludeon.RimWorld.Ideology">0.05</Junkyard>
      <ArcheanTrees>0.01</ArcheanTrees>
      <MineralRich>0.03</MineralRich>
      <MixedBiome>0.5</MixedBiome>
      <AncientUplink>0.02</AncientUplink>
      <Stockpile>0.05</Stockpile>
      <AnimalLife_Increased>0.05</AnimalLife_Increased>
      <AnimalHabitat>0.15</AnimalHabitat>
      <PlantLife_Increased>0.03</PlantLife_Increased>
      <Fertile>0.05</Fertile>
      <Sandy>0.05</Sandy>
      <DryGround>0.05</DryGround>
      <MineralRich>0.05</MineralRich>
      <InsectMegahive>0.04</InsectMegahive>
      <FoggyMutator>0.05</FoggyMutator>
      <WildGalacticPlants>0.05</WildGalacticPlants>
      <WildRylothPlants>0.05</WildRylothPlants>
      <WildTattooinePlants>0.05</WildTattooinePlants>
      <WildNabooPlants>0.05</WildNabooPlants>
      <WildDantooinePlants>0.05</WildDantooinePlants>
      <WildAlderaanPlants>0.03</WildAlderaanPlants>
      <WildFelucianPlants>0.03</WildFelucianPlants>
    </mutatorChances>
    <comboLandmarkMutators>
      <Dunes>0.05</Dunes>
      <Sandy>0.02</Sandy>
      <Hollow>0.02</Hollow>
      <Chasm>0.02</Chasm>
      <Valley>0.01</Valley>
      <Cavern>0.01</Cavern>
    </comboLandmarkMutators>
  </LandmarkDef>
  <TileMutatorDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>sw_DeadSarlaccCave</defName>
    <label>a dead sarlacc</label>
    <description>This area hosts a dead sarlacc creature. These sessile creatures are known to have millenia long lifespans, but are ultimately mortal. Whether from disease, starvation, burrowing insectoids or even old age they eventually die and leave a cavern where the bulk of their corpse has rotted away.</description>
    <biomeBlacklist>
      <li>SeaIce</li>
      <li>IceSheet</li>
      <li>GlacialPlain</li>
    </biomeBlacklist>
    <maxHilliness>Mountainous</maxHilliness>
    <extraGenSteps>
      <li>sw_DeadSarlaccPit</li>
    </extraGenSteps>
  </TileMutatorDef>
  <GenStepDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>sw_DeadSarlaccPit</defName>
    <order>950</order>
    <genStep Class="GenStep_ScatterThings">
      <thingDef>DeadSarlacc</thingDef>
      <createUsedRect>true</createUsedRect>
      <allowInWaterBiome>false</allowInWaterBiome>
      <skipRoofed>true</skipRoofed>
      <countPer10kCellsRange>1~1</countPer10kCellsRange>
      <clearSpaceSize>10</clearSpaceSize>
      <terrainValidationDisallowed>
        <li>Road</li>
      </terrainValidationDisallowed>
      <count>1</count>
      <warnOnFail>false</warnOnFail>
    </genStep>
  </GenStepDef>
</Defs>
