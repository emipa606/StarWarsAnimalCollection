  <ThingDef Name="Plant_FelucianGlowspore" ParentName="TreeBase">
    <defName>Plant_FelucianGlowspore</defName>
    <label>felucian glowspore</label>
    <description>A giant floral tree from the jungle planet of Felucia that produces edible blue foliage. It has been genetically engineered to from it's baseline poisonous spore variant to make it's floral growths edible and allowing it to survive in slightly less-warm climates.</description>
    <graphicData>
      <texPath>swplants/FelucianGlowspore</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.15, 0.3, 0.15)</volume>
        <offset>(0,0,-0.38)</offset>
      </shadowData>
    </graphicData>
    <selectable>true</selectable>
    <statBases>
      <Beauty>20</Beauty>
      <BeautyOutdoors>20</BeautyOutdoors>
      <Nutrition>2.0</Nutrition>
    </statBases>
    <minifiedDef>MinifiedTree</minifiedDef>
    <ingestible />
    <plant>
      <fertilitySensitivity>1.0</fertilitySensitivity>
      <growDays>10</growDays>
      <visualSizeRange>1~3</visualSizeRange>
      <sowMinSkill>8</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <sowResearchPrerequisites Inherit="False">
        <li>TreeSowing</li>
      </sowResearchPrerequisites>
      <topWindExposure>0.15</topWindExposure>
      <mustBeWildToSow>false</mustBeWildToSow>
      <immatureGraphicPath>swplants/FelucianGlowspore_Immature</immatureGraphicPath>
      <leaflessGraphicPath>swplants/FelucianGlowspore_Leafless</leaflessGraphicPath>
      <snowOverlayGraphicPath>swplants/FelucianGlowspore_Snowy</snowOverlayGraphicPath>
      <leaflessSnowOverlayGraphicPath>swplants/FelucianGlowspore_LeaflessSnowy</leaflessSnowOverlayGraphicPath>
      <immatureSnowOverlayGraphicPath>swplants/FelucianGlowspore_ImmatureSnowy</immatureSnowOverlayGraphicPath>
      <harvestWork>300</harvestWork>
      <harvestTag>Standard</harvestTag>
      <forceIsTree>true</forceIsTree>
      <harvestYield>50</harvestYield>
      <harvestedThingDef>RawFelucianLettuce</harvestedThingDef>
      <harvestFailable>true</harvestFailable>
      <harvestAfterGrowth>0.30</harvestAfterGrowth>
      <maxGrowthTemperature>75</maxGrowthTemperature>
    </plant>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(0,255,255,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
