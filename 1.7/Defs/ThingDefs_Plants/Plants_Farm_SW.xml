  <ThingDef Name="Plant_Dantuber" ParentName="PlantBase">
    <defName>Plant_Dantuber</defName>
    <label>dantuber plant</label>
    <description>A large tuber vegtable from the planet Dantooine. It was a popular crop grown for the "Dantooine Spring Abundance Festival". It's low yield was countered by it's high nutrition value and it became a popular root vegetable on other worlds.</description>
