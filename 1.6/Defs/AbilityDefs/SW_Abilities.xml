  <ThingDef ParentName="BaseBullet" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>Bullet_AnimalToxbomb</defName>
    <label>toxic vomit</label>
    <graphicData>
      <texPath>Things/Projectile/Acid</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>0.85</drawSize>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <speed>25</speed>
      <damageDef>ToxGas</damageDef>
      <explosionRadius>3.9</explosionRadius>
      <explosionRadiusDisplayPadding>2</explosionRadiusDisplayPadding>
      <postExplosionGasType>ToxGas</postExplosionGasType>
      <arcHeightFactor>0.4</arcHeightFactor>
      <shadowSize>0</shadowSize>
      <filth>Filth_Slime</filth>
      <filthCount>1</filthCount>
      <filthChance>0.25</filthChance>
    </projectile>
