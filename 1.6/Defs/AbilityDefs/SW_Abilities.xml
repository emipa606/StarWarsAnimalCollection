<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <AbilityDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>SW_AcidSpew</defName>
    <label>acid spew</label>
    <description>Spray offensive stomach acid all over the target area. The acid will stick to targets and burn them.</description>
    <iconPath>UI/Abilities/Ability_AnimalAcidSpray</iconPath>
    <cooldownTicksRange>2500</cooldownTicksRange>
    <!-- 1 hours -->
    <displayOrder>300</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <warmupStartSound>AcidSpray_Warmup</warmupStartSound>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <requireLineOfSight>true</requireLineOfSight>
      <range>8.9</range>
      <warmupTime>0.5</warmupTime>
      <soundCast>AcidSpray_Resolve</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityRequiresTrainable">
        <trainableDef>SW_AcidSpew</trainableDef>
        <aiCanCastWithoutTrainable>true</aiCanCastWithoutTrainable>
      </li>
      <li Class="CompProperties_AbilitySprayLiquid" MayRequire="Ludeon.RimWorld.Biotech">
        <projectileDef>Proj_Acid</projectileDef>
        <numCellsToHit>18</numCellsToHit>
        <sprayEffecter>AcidSpray_Directional</sprayEffecter>
      </li>
    </comps>
  </AbilityDef>
  <TrainableDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>SW_AcidSpew</defName>
    <label>acid spew</label>
    <description>Command the creature to spray an acidic at a target. Once trained, the creature will spew acid on command.</description>
    <listPriority>0</listPriority>
    <difficulty>200</difficulty>
    <steps>2</steps>
    <specialTrainable>true</specialTrainable>
    <enablesAbility>SW_AcidSpew</enablesAbility>
  </TrainableDef>
  <AbilityDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>SW_Leap</defName>
    <label>animal leap</label>
    <description>Jump to a distant location using strong hind legs.</description>
    <iconPath>UI/Abilities/Ability_AnimalLeap</iconPath>
    <cooldownTicksRange>25000</cooldownTicksRange>
    <!-- 1 hours -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <hostile>false</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbilityJump</verbClass>
      <label>leap</label>
      <violent>false</violent>
      <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
      <warmupTime>0.5</warmupTime>
      <range>19.9</range>
      <requireLineOfSight>true</requireLineOfSight>
      <soundCast>Ability_Leap_Air</soundCast>
      <soundLanding>Ability_Leap_Land</soundLanding>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityRequiresTrainable">
        <trainableDef>SW_Leap</trainableDef>
        <aiCanCastWithoutTrainable>true</aiCanCastWithoutTrainable>
      </li>
    </comps>
    <jobDef>CastJump</jobDef>
