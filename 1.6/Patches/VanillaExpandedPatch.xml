<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Expanded Framework</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Bogwing" or defName="Aiwha" or defName="Brezak" or defName="CanCell" or defName="Dactillion" or defName="Hawkbat" or defName="Beldon" or defName="Convor" or defName="Mynock" or defName="PekoPeko"or defName="Porg" or defName="Shyrack" or defName="Thranta" or defName="Whisperbird" or defName="Drexl" or defName="Tibidee"or defName="Uvak"or defName="Sketto"or defName="Urusai"or defName="Neebray"]/comps</xpath>
          <value>
            <li Class="VEF.AnimalBehaviours.CompProperties_Floating" />
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Aiwha"]/comps</xpath>
          <value>
            <li Class="VEF.AnimalBehaviours.CompProperties_DigWhenHungry">
              <customThingsToDig>
                <li>Crustapod_Meat</li>
              </customThingsToDig>
              <customAmountsToDig>
                <li>10</li>
              </customAmountsToDig>
              <spawnForbidden>true</spawnForbidden>
              <digOnlyOnGrowingSeason>false</digOnlyOnGrowingSeason>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="FrogDog"]/comps</xpath>
          <value>
            <li Class="VEF.AnimalBehaviours.CompProperties_DigWhenHungry">
              <customThingsToDig>
                <li>Insectile_Meat</li>
              </customThingsToDig>
              <customAmountsToDig>
                <li>5</li>
              </customAmountsToDig>
              <spawnForbidden>true</spawnForbidden>
              <digOnlyOnGrowingSeason>false</digOnlyOnGrowingSeason>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Strill"]/comps</xpath>
          <value>
            <li Class="VEF.AnimalBehaviours.CompProperties_DigWhenHungry">
              <customThingsToDig>
                <li>Insectile_Meat</li>
              </customThingsToDig>
              <customAmountsToDig>
                <li>5</li>
              </customAmountsToDig>
              <spawnForbidden>true</spawnForbidden>
              <digOnlyOnGrowingSeason>false</digOnlyOnGrowingSeason>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Orray"]/comps</xpath>
          <value>
            <li Class="VEF.AnimalBehaviours.CompProperties_DigWhenHungry">
              <customThingsToDig>
                <li>Insectile_Meat</li>
              </customThingsToDig>
              <customAmountsToDig>
                <li>10</li>
              </customAmountsToDig>
              <spawnForbidden>true</spawnForbidden>
              <digOnlyOnGrowingSeason>false</digOnlyOnGrowingSeason>
            </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
